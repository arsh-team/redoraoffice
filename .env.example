# Copy to .env.local and fill in. Nothing here is required to run the site.

# Canonical origin used for metadata, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://redoraoffice.ir

# Where submitted forms are delivered (server-side only, never sent to the browser).
# Each receives a JSON POST; see lib/forms/delivery.ts for the payload and for
# how to swap in another transport. While a URL is empty the matching form
# tells visitors that their request was NOT sent and shows the phone and e-mail.
CONTACT_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=

# Optional: form posts allowed per client per 10 minutes (default 6).
# FORM_RATE_LIMIT_MAX=6
